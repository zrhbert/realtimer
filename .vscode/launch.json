{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run in Hatari",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}${/}realtim5.prg",
            "args": [],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}",
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerServerAddress": "localhost:2345",
            "serverStarted": "You have entered debug mode.",
            "filterStderr": true,
            "serverLaunchTimeout": 30000,
            "windows": {
                "miDebuggerPath": "${config:atariSTDev.path}\\opt\\cross-mint\\bin\\m68k-atari-mintelf-gdb.exe",
                "debugServerPath": "${config:atariSTDev.path}\\hatari\\hatari.exe",
                "debugServerArgs": "--tos \"${config:atariSTDev.path}\\hatari\\etos512us.img\" --confirm-quit no --sound off --memsize 4 --mono --fast-forward yes --parse \"${config:atariSTDev.path}\\hatari\\db.ini\" \"${workspaceFolder}\\rt5run.prg\""
            },
            "osx": {
                "miDebuggerPath": "${config:atariSTDev.path}/opt/cross-mint/bin/m68k-atari-mintelf-gdb",
                "debugServerPath": "${config:atariSTDev.path}/hatari/Hatari.app/Contents/MacOS/Hatari",
                "debugServerArgs": "--tos \"${config:atariSTDev.path}/hatari/etos512us.img\" --confirm-quit no --sound off --memsize 4 --mono --fast-forward yes \"${workspaceFolder}/rt5run.prg\""
            },
            "linux": {
                "miDebuggerPath": "${config:atariSTDev.path}/opt/cross-mint/bin/m68k-atari-mintelf-gdb",
                "debugServerPath": "${config:atariSTDev.path}/hatari/hatari",
                "debugServerArgs": "--tos \"${config:atariSTDev.path}/hatari/etos512us.img\" --confirm-quit no --sound off --memsize 4 --mono --fast-forward yes --parse \"${config:atariSTDev.path}/hatari/db.ini\" \"${workspaceFolder}/rt5run.prg\""
            },
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Atari ST: make",
            "logging": {
                "engineLogging": true
            }
        },
