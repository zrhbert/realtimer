{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Atari ST: make",
            "command": "make",
            "args": [],
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build PRG from Makefile for Atari ST."
        },
        {
            "type": "shell",
            "label": "Atari ST: make clean",
            "command": "make",
            "args": [
                "clean"
            ],
            "detail": "Cleanup from Makefile for Atari ST."
        },
        {
            "type": "shell",
            "label": "Atari ST: run",
            "command": "${config:atariSTDev.path}/hatari/hatari",
            "osx": {
                "command": "${config:atariSTDev.path}/hatari/Hatari.app/Contents/MacOS/Hatari"
            },
            "args": [
                "--tos", "${config:atariSTDev.path}/hatari/etos512us.img",
                "--confirm-quit", "no",
                "--sound", "off",
                "--memsize", "4",
                "--mono",
                "--fast-forward", "yes",
                "--parse", "${config:atariSTDev.path}/hatari/db.ini",
                "${workspaceFolder}${/}realtim5gcc.app"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "detail": "Run PRG from Makefile for Atari ST.",
            "dependsOn": "Atari ST: make"
        }
    ]
}
