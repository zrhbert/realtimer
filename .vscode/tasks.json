{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Atari ST: sdk link",
            "command": "${workspaceFolder}/tools/atari_sdk_link.sh",
            "problemMatcher": [],
            "detail": "Point the stable atari-sdk symlink at the newest installed Atari ST Dev extension (self-heals after extension updates)."
        },
        {
            "type": "shell",
            "label": "Atari ST: make",
            "command": "make",
            "args": [],
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build PRG from Makefile for Atari ST.",
            "dependsOn": "Atari ST: sdk link"
        },
        {
            "type": "shell",
            "label": "Atari ST: make clean",
            "command": "make",
            "args": [
                "clean"
            ],
            "detail": "Cleanup from Makefile for Atari ST."
        },
        {
            "type": "shell",
            "label": "Atari ST: run",
            "command": "${config:realtimer.atariSdk}/hatari/hatari",
            "osx": {
                "command": "${config:realtimer.atariSdk}/hatari/Hatari.app/Contents/MacOS/Hatari"
            },
            "args": [
                "--tos", "${config:realtimer.atariSdk}/hatari/etos512us.img",
                "--confirm-quit", "no",
                "--sound", "off",
                "--memsize", "4",
                "--mono",
                "--fast-forward", "yes",
                "--parse", "${config:realtimer.atariSdk}/hatari/db.ini",
                "${workspaceFolder}${/}realtim5.prg"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "detail": "Run PRG from Makefile for Atari ST.",
            "dependsOn": "Atari ST: make"
        },
        {
            "type": "shell",
            "label": "Hatari: control session",
            "command": "python3",
            "args": [
                "tools/hatari_control.py",
                "--keep-open"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "Run the PRG in Hatari with a control socket and an interactive prompt for simulated keys, screenshots and debugger commands (see tools/README.md).",
            "dependsOn": "Atari ST: make"
        },
        {
            "type": "shell",
            "label": "Hatari: smoke test",
            "command": "python3",
            "args": [
                "tools/hatari_control.py",
                "--script", "tools/smoke.hatari"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "Boot, screenshot, press F8, screenshot, quit; results in build/hatari-shots/.",
            "dependsOn": "Atari ST: make"
        },
        {
            "type": "shell",
            "label": "MagiC on Linux: write config",
            "command": "mkdir -p build && sed -e 's#@WORKSPACE@#${workspaceFolder}#g' .vscode/magic-on-linux.conf.in > build/magic-on-linux.conf",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "Generate build/magic-on-linux.conf from .vscode/magic-on-linux.conf.in with this workspace mapped as drive R:."
        },
        {
            "label": "MagiC on Linux: prepare",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Atari ST: make",
                "MagiC on Linux: write config"
            ],
            "problemMatcher": [],
            "detail": "Build the PRG and generate the magic-on-linux configuration."
        },
        {
            "type": "shell",
            "label": "MagiC on Linux: run",
            "command": "${config:realtimer.magicOnLinuxPath}",
            "args": [
                "-c", "${workspaceFolder}/build/magic-on-linux.conf",
                "R:\\REALTIM5.PRG"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "Run REALTIM5.PRG in MagiC on Linux (no debugger).",
            "dependsOn": "MagiC on Linux: prepare"
        }
    ]
}
